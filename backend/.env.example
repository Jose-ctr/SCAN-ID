# ============================================================
# SCAN-ID
# Environment Configuration Example
# ============================================================
#
# Copy this file to:
#
#   backend/.env
#
# NEVER commit the real .env file.
# ============================================================


# ============================================================
# APPLICATION
# ============================================================

APP_NAME=SCAN-ID

# development | production
APP_ENV=development

APP_DEBUG=true

APP_URL=http://localhost:8000

APP_TIMEZONE=Africa/Nairobi


# ============================================================
# DATABASE
# ============================================================

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=scan_id
DB_USER=postgres
DB_PASSWORD=

# Optional PostgreSQL SSL mode.
# Common values:
# prefer
# require
# verify-ca
# verify-full
DB_SSLMODE=prefer


# ============================================================
# CORS
# ============================================================

# Frontend development server.
CORS_ORIGIN=http://localhost:5173


# ============================================================
# AUTHENTICATION / SESSIONS
# ============================================================

# Session lifetime in seconds.
# 86400 = 24 hours.
SESSION_LIFETIME=86400


# ============================================================
# RECOVERY PRICING
# ============================================================
#
# Owner pays exactly KSh 300.
#
# KSh 150 -> Finder reward
# KSh 150 -> SCAN-ID platform
#
# No additional recovery fee is charged on top.
# ============================================================

RECOVERY_FEE_KES=300

FINDER_REWARD_KES=150

PLATFORM_FEE_KES=150


# ============================================================
# SMS — AFRICA'S TALKING
# ============================================================

# sandbox | production
AT_ENV=sandbox

AT_USERNAME=

AT_API_KEY=

AT_SENDER_ID=SCAN-ID

# Africa's Talking SMS endpoint.
AT_SMS_URL=https://api.sandbox.africastalking.com/version1/messaging


# ============================================================
# M-PESA DARaja
# ============================================================
#
# NEVER expose these values in the frontend.
# NEVER commit real credentials.
# ============================================================

MPESA_ENV=sandbox

MPESA_CONSUMER_KEY=

MPESA_CONSUMER_SECRET=

MPESA_SHORTCODE=

MPESA_PASSKEY=

# Public HTTPS callback URL.
#
# Example:
# https://api.example.com/api/payments/callback
#
MPESA_CALLBACK_URL=


# ============================================================
# STORAGE
# ============================================================

STORAGE_PATH=./storage


# ============================================================
# UPLOADS
# ============================================================

# 5 MB
UPLOAD_MAX_BYTES=5242880


# ============================================================
# API RATE LIMITING
# ============================================================

RATE_LIMIT_MAX=60

RATE_LIMIT_WINDOW=60


# ============================================================
# SECURITY
# ============================================================

# Optional application secret for future signed operations.
# Generate a long random value in production.
APP_KEY=
